# ============================================================================
# StockBrain AI Provider Configuration
# ============================================================================
# Configure at least ONE AI provider for chat and analysis features.
# See AI_PROVIDERS_GUIDE.md for detailed cost breakdowns and setup instructions.

# ============================================================================
# RECOMMENDED SETUP (Choose one)
# ============================================================================

# Option 1: FREE Setup (Best for getting started)
# -----------------------------------------------
# Get Gemini API key: https://ai.google.dev/
VITE_GEMINI_API_KEY=

# Option 2: OpenRouter (ONE key for ALL models - Recommended for production)
# ---------------------------------------------------------------------------
# Access Grok, Claude, GPT, Gemini, DeepSeek, Qwen, GLM, Minimax with ONE key
# Get key from: https://openrouter.ai/keys
# Cost: FREE models available + pay-as-you-go for premium models
VITE_OPENROUTER_API_KEY=

# Option 3: Multi-Provider Setup (Maximum flexibility)
# -----------------------------------------------------
# Configure multiple providers for automatic fallback and load balancing

# ============================================================================
# DIRECT PROVIDER API KEYS
# ============================================================================

# Google Gemini (RECOMMENDED - Best free tier)
# Get key: https://ai.google.dev/
# Cost: FREE tier (15 requests/min) or $0.075/$0.30 per 1M tokens
VITE_GEMINI_API_KEY=

# Anthropic Claude (Highest quality)
# Get key: https://console.anthropic.com/
# Cost: $3.00/$15.00 per 1M tokens (Sonnet), $1.00/$5.00 (Haiku)
VITE_CLAUDE_API_KEY=

# OpenAI (Most popular)
# Get key: https://platform.openai.com/api-keys
# Cost: $2.50/$10.00 per 1M tokens (GPT-4o), $0.15/$0.60 (GPT-4o Mini)
VITE_OPENAI_API_KEY=

# xAI Grok (Latest features, real-time web search)
# Get key: https://x.ai/api (requires X Premium+ subscription)
# Cost: $5.00/$15.00 per 1M tokens
VITE_GROK_API_KEY=

# DeepSeek (Best value - Direct API)
# Get key: https://platform.deepseek.com/
# Cost: $0.27/$1.10 per 1M tokens (Chat), $0.55/$2.19 (R1 Reasoning)
VITE_DEEPSEEK_API_KEY=

# ============================================================================
# OPENROUTER - ONE KEY FOR ALL MODELS
# ============================================================================
# OpenRouter gives you access to ALL models from ALL providers with one key:
# - Grok (all models)
# - Claude (all models)
# - GPT (all models)
# - Gemini (all models)
# - DeepSeek (FREE)
# - Qwen (FREE)
# - GLM (FREE)
# - Minimax (FREE)
# - 100+ other models
#
# Get key: https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs
VITE_OPENROUTER_API_KEY=

# ============================================================================
# CLOUDFLARE AI (ALWAYS AVAILABLE)
# ============================================================================
# Cloudflare AI is automatically available - no API key needed!
# FREE tier: 10,000 neurons/day
# Models: Llama 3.1 8B, Llama 3.1 70B, UForm Gen2 (vision)
# No configuration needed - works out of the box

# ============================================================================
# LEGACY OPENROUTER INDIVIDUAL MODEL KEYS (DEPRECATED)
# ============================================================================
# These are deprecated. Use VITE_OPENROUTER_API_KEY instead for access to all models.
# VITE_OPENROUTER_QWEN3_CODER_API_KEY=
# VITE_OPENROUTER_DEEPSEEK_R1T2_API_KEY=
# VITE_OPENROUTER_DEEPSEEK_CHAT_API_KEY=
# VITE_OPENROUTER_MINIMAX_M2_API_KEY=
# VITE_OPENROUTER_GLM_45_AIR_API_KEY=
# VITE_OPENROUTER_QWEN3_235B_API_KEY=

# ============================================================================
# OPTIONAL APIs
# ============================================================================

# Odds API (for sports betting data)
# Get key: https://the-odds-api.com/
VITE_ODDS_API_KEY=

# ============================================================================
# QUICK START EXAMPLES
# ============================================================================

# Example 1: FREE Setup (No cost)
# --------------------------------
# VITE_GEMINI_API_KEY=AIzaSy...your_free_gemini_key

# Example 2: OpenRouter Only (Best for production)
# -------------------------------------------------
# VITE_OPENROUTER_API_KEY=sk-or-v1-...your_openrouter_key

# Example 3: Multi-Provider (Maximum flexibility)
# ------------------------------------------------
# VITE_GEMINI_API_KEY=AIzaSy...your_gemini_key
# VITE_CLAUDE_API_KEY=sk-ant-...your_claude_key
# VITE_OPENAI_API_KEY=sk-...your_openai_key
# VITE_OPENROUTER_API_KEY=sk-or-v1-...your_openrouter_key

# ============================================================================
# COST COMPARISON (Light Use: 100 requests/day, 500 tokens each)
# ============================================================================
# Cloudflare AI:        $0/month (FREE)
# Gemini Flash (Free):  $0/month (FREE)
# OpenRouter (Free):    $0/month (FREE - DeepSeek/Qwen models)
# Gemini Flash (Paid):  ~$3/month
# Claude Haiku:         ~$60/month
# GPT-4o Mini:          ~$9/month
# Claude Sonnet:        ~$180/month
# GPT-4o:               ~$250/month

# ============================================================================
# For detailed setup instructions, cost breakdowns, and provider comparison:
# See: AI_PROVIDERS_GUIDE.md
# ============================================================================
